{
  "name": "crash-game",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*",
    "packages/@crash/*",
    "frontend"
  ],
  "scripts": {
    "docker:prepare": "sh scripts/docker-prepare.sh",
    "docker:up": "sh scripts/docker-prepare.sh && docker compose up --build",
    "docker:up:detached": "sh scripts/docker-prepare.sh && docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:prune": "docker compose down -v --rmi all --remove-orphans && docker volume prune -f",
    "verify:round": "bun scripts/verify-round.ts"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
